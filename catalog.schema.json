{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-hermes-pets/catalog.schema.json",
  "title": "Codex and Hermes Pet Catalogue",
  "type": "object",
  "required": ["catalogVersion", "name", "pets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "pets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "description", "status", "license", "manifest", "preview"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "published", "deprecated"] },
          "license": { "const": "CC-BY-4.0" },
          "manifest": { "type": "string", "pattern": "^pets/[^/]+/pet\\.json$" },
          "preview": { "type": "string", "pattern": "^pets/[^/]+/preview\\.png$" },
          "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "derivedFrom": { "type": ["string", "null"] }
        }
      }
    }
  }
}
